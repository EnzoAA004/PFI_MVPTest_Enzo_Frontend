# Frontend - variables de entorno
#
# Hay dos momentos distintos y conviene no confundirlos.
#
# 1. BUILD (Vite). Las VITE_* se congelan dentro del bundle al compilar. Sirven para
#    `npm run dev` y `npm run build` fuera de Docker.
# 2. RUNTIME (contenedor). La imagen ya construida lee BACKEND_URL y con eso genera
#    /env.js, que el navegador carga antes que el bundle. Por eso la misma imagen sirve
#    para cualquier entorno sin recompilar: ver docker/entrypoint.sh.
#
# Cuando las dos estan presentes, gana la de runtime (window.__PFI_CONFIG__).

# ---- Build ----

# URL del backend que queda embebida en el bundle. Es la que ve el navegador, no la de la
# red interna de Docker: `http://backend:8080` no lo resuelve nadie desde el navegador.
VITE_API_BASE_URL=http://localhost:8080

# Con true la app usa fixtures en memoria y no llama al backend. Solo para desarrollo de
# UI sin backend levantado.
VITE_USE_MOCK=false

# ---- Runtime del contenedor ----

# La lee docker/entrypoint.sh y la escribe en /usr/share/nginx/html/env.js. Es la unica
# variable que hace falta para configurar una imagen ya publicada.
BACKEND_URL=http://localhost:8080
